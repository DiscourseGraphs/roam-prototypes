{
  // Opt-in strict typecheck (`pnpm exec tsc -p tsconfig.check.json`): the
  // repository has no typecheck step and the shared tsconfig predates
  // TypeScript 6's removal of node10 moduleResolution, so this carries its
  // own modern compilerOptions instead of extending it.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "tests"]
}
